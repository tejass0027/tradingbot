# Discord incoming webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# Which instruments to monitor (true/false)
ENABLE_NIFTY=true
ENABLE_BTC=true
ENABLE_USDINR=true

# NSE index symbol for the options chain (NIFTY = Nifty 50)
NSE_SYMBOL=NIFTY

# yfinance ticker for the underlying spot/history (Nifty 50 index)
YFINANCE_TICKER=^NSEI

# yfinance ticker for BTC spot/history
BTC_YFINANCE_TICKER=BTC-USD

# yfinance ticker for the USD/INR forex pair
USDINR_YFINANCE_TICKER=USDINR=X

# Annualized risk-free rate used in Nifty's Black-Scholes Greeks calculation
RISK_FREE_RATE=0.07

# How often the bot checks for a signal, in seconds (300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# Minimum/maximum days to expiry when selecting Nifty's options chain
MIN_DAYS_TO_EXPIRY=7
MAX_DAYS_TO_EXPIRY=30

# Nifty: profit target / stop-loss for exiting an open position, as a
# fraction of the option premium (0.20 = 20% gain, 0.30 = 30% loss)
PROFIT_TARGET_PCT=0.20
STOP_LOSS_PCT=0.30

# BTC: profit target / stop-loss for exiting an open position, as a fraction
# of the spot price itself (0.03 = 3% gain, 0.02 = 2% loss). Kept much
# tighter than Nifty's since these track the underlying price directly, not
# a leveraged option premium.
BTC_PROFIT_TARGET_PCT=0.03
BTC_STOP_LOSS_PCT=0.02

# BTC: optional flat-dollar profit target, overriding BTC_PROFIT_TARGET_PCT
# for the target price specifically (stop-loss stays percentage-based).
# E.g. 100 means "exit once the position is up exactly $100", regardless of
# entry price. Leave empty/unset to use the percentage-based target instead.
BTC_PROFIT_TARGET_DOLLARS=100

# Lookback period (in candles) for the Simple Moving Average
SMA_PERIOD=20

# Trend-confirmation filter: BUY signals only fire when price is also above
# this longer/slower SMA (rejects crossovers against the broader trend, e.g.
# in a choppy/sideways market). Set to 0 to disable.
TREND_SMA_PERIOD=50

# How often to send a "still running" heartbeat message to Discord,
# regardless of whether a real trade signal fired, in seconds (3600 = 1 hour)
HEARTBEAT_INTERVAL_SECONDS=3600

# BTC: momentum filters on top of the SMA crossover, validated via
# backtest.py (100 trades / 60 days, 33% win rate, +10.26% compounded return
# vs. +1.23% baseline with the bare crossover; confirmed positive across both
# halves of the window independently). A BUY only fires if MACD's histogram
# is positive AND price is at/above the given Fibonacci retracement level.
BTC_USE_MACD_FILTER=true
BTC_FIB_LOOKBACK=50
BTC_FIB_LEVEL=0.618

# USD/INR: profit target / stop-loss, as a fraction of the rate itself.
# Much tighter than BTC's - forex moves are far smaller than crypto's, sized
# off USD/INR's actual intraday volatility (0.4% / 0.2%).
USDINR_PROFIT_TARGET_PCT=0.004
USDINR_STOP_LOSS_PCT=0.002

# USD/INR: same filter stack as BTC, plus a trend-confirmation SMA - this
# combo was needed for USD/INR specifically since the bare crossover alone
# was unprofitable in backtesting. Validated via backtest.py (21 trades /
# 60 days, 42.9% win rate, +0.59% compounded return, positive in both
# halves of the window independently) - a much smaller, less certain edge
# than BTC's given how much smaller forex moves are.
USDINR_TREND_SMA_PERIOD=50
USDINR_USE_MACD_FILTER=true
USDINR_FIB_LOOKBACK=50
USDINR_FIB_LEVEL=0.618
