FROM python:3.12-slim

WORKDIR /app

# See the main Dockerfile for why this matters (unbuffered stdout so logs
# actually reach the platform's log viewer, especially if the process dies).
ENV PYTHONUNBUFFERED=1

COPY requirements-btc.txt .
RUN pip install --no-cache-dir -r requirements-btc.txt

COPY main.py analyzer.py data_client.py strategy.py alerter.py ./

# .env and state_btc.json are provided at runtime (mounted or passed via env),
# not baked into the image - see DEPLOY.md or DEPLOY_RAILWAY.md.
CMD ["python", "main.py"]
